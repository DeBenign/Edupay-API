NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database & cache ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Nomba ─────────────────────────────────────────────────────────
NOMBA_BASE_URL=https://api.nomba.com/v1
NOMBA_ACCOUNT_ID=
NOMBA_SUB_ACCOUNT_ID=
NOMBA_CLIENT_ID=
NOMBA_SECRET_KEY=
NOMBA_WEBHOOK_SECRET=
NOMBA_FEE_RATE=0.01
NOMBA_FEE_CAP=300

# ── Paystack ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_FEE_RATE=0.01
PAYSTACK_FEE_CAP=300

# ── VTU (VTpass) — referral airtime rewards ─────────────────────────
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PIN=

# ── Platform admin ────────────────────────────────────────────────
# Comma-separated list of emails treated as platform admin (requirePlatformAdmin middleware)
PLATFORM_ADMIN_EMAILS=you@example.com
