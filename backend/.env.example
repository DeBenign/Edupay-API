# EduPay backend: template only. Copy to .env and fill in YOUR values. NEVER put real secrets in this file.
NODE_ENV=production
PORT=5000

# Exact origin of the deployed frontend: no trailing slash. Used for CORS and for the links inside emails.
# Local: http://localhost:5173   Vercel: https://edupay-web.vercel.app
# Several origins can be comma-separated: https://edupay-web.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Database & cache ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/edupay
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Nomba ─────────────────────────────────────────────────────────
NOMBA_BASE_URL=https://api.nomba.com
NOMBA_ACCOUNT_ID=
NOMBA_SUB_ACCOUNT_ID=
NOMBA_CLIENT_ID=
NOMBA_SECRET_KEY=
NOMBA_WEBHOOK_SECRET=

# EduPay's service charge added on top of the school fee (1.5% + N100, capped at N2,000, flat waived at or below N2,500)
NOMBA_FEE_RATE=0.015
NOMBA_FEE_FLAT=100
NOMBA_FEE_CAP=2000

# ── Paystack ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_FEE_RATE=0.01
PAYSTACK_FEE_CAP=300
PAYSTACK_MOCK_MODE=true

# ── VTU (VTpass): referral airtime rewards ────────────────────────
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PIN=

# ── Platform admin (the EduPay owner) ─────────────────────────────
# Comma-separated login emails. Read ONCE when the server starts:
#   local  -> restart `npm run dev` after changing it
#   Vercel -> change it in Project Settings > Environment Variables, then Redeploy
# Then create the account:  node src/scripts/createPlatformAdmin.js "Full Name" owner@email.com "StrongPassword"
# Check it:                 node src/scripts/checkPlatformAdmin.js owner@email.com
PLATFORM_ADMIN_EMAILS=owner@example.com

# ── Subscription (billing the schools) ────────────────────────────
SUBSCRIPTION_PER_STUDENT=300
SUBSCRIPTION_MINIMUM=30000
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_BANK_NAME=
SUBSCRIPTION_ACCOUNT_NUMBER=
SUBSCRIPTION_ACCOUNT_NAME=

# ── Email (SMTP) ──────────────────────────────────────────────────
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<Brevo SMTP login>  SMTP_PASS=<Brevo SMTP key>
# Gmail:  SMTP_HOST=smtp.gmail.com        SMTP_PORT=587  SMTP_USER=<you@gmail.com>     SMTP_PASS=<16-char app password>
# Test it: node src/scripts/testEmail.js you@yourinbox.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EduPay <no-reply@yourdomain.com>"

# ── Cron (Vercel) ─────────────────────────────────────────────────
# Long random string, at least 32 characters:  openssl rand -hex 32
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the paths listed in vercel.json "crons".
CRON_SECRET=
