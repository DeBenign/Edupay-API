NOMBA_WEBHOOK_SECRET=4c68650cc9839a124338f6d97be4091835877e6d86f0f2f8d34dd5aac0e7a6fd

# EduPay's service charge added on top of the school fee (NOT the gateway's own fee).
# Finalized model: 1.5% + N100 flat, capped at N2,000, flat waived at or below N2,500.
# Leave these unset to use those defaults. Do not set 0.01 / 300: that would silently shrink the charge.
NOMBA_FEE_RATE=0.015
NOMBA_FEE_FLAT=100
NOMBA_FEE_CAP=2000

# ── Paystack ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_1b8e3d7350f81340be3f171ba9d146f3e96d3082
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_FEE_RATE=0.01
PAYSTACK_FEE_CAP=300 
PAYSTACK_MOCK_MODE=true

# ── VTU (VTpass) — referral airtime rewards ─────────────────────────
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PIN=

# ── Platform admin ────────────────────────────────────────────────
# Comma-separated list of emails treated as platform admin (requirePlatformAdmin middleware)
PLATFORM_ADMIN_EMAILS=you@example.com   # MUST be the real login email of the EduPay owner, or /admin/subscriptions stays hidden

# ── Subscription (billing the schools) ────────────────────────────
SUBSCRIPTION_PER_STUDENT=300
SUBSCRIPTION_MINIMUM=30000
SUBSCRIPTION_GRACE_DAYS=7

# Where schools pay the subscription. Env only, never hard-code these in the repo.
SUBSCRIPTION_BANK_NAME=
SUBSCRIPTION_ACCOUNT_NUMBER=
SUBSCRIPTION_ACCOUNT_NAME=

# ── Email (verification + notifications) ──────────────────────────
# Any SMTP provider works: Brevo, Zoho, Resend (SMTP), SendGrid, Gmail app password.
# Use a sender on a domain you own and set up SPF/DKIM there, or mail lands in spam.
# Without these, no email is sent (development prints the message in the terminal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EduPay <no-reply@yourdomain.com>"
# CLIENT_URL (above) must be your real frontend URL: the links in emails are built from it.

# ── Vercel cron (hosting on Vercel) ───────────────────────────────
# Any long random string. Vercel sends it as a Bearer token to /api/cron/*
# Ping often from a free external pinger (header: Authorization: Bearer <CRON_SECRET>):
#   /api/cron/emails and /api/cron/provision  (safe to call every 5 to 15 minutes)
# Once a day only: /api/cron/reminders (it sends fee reminders to parents)
CRON_SECRET=
