{
  "version": 2,
  "functions": { "api/index.js": { "maxDuration": 30, "includeFiles": "src/**" } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/api/cron/sync",      "schedule": "0 0 * * *" },
    { "path": "/api/cron/reminders", "schedule": "0 7 * * *" },
    { "path": "/api/cron/vtu",       "schedule": "30 0 * * *" }
  ]
}
