# EduPay frontend: template only (these values are public in the built site, so never put secrets here).
# Vite bakes them in at BUILD time: after changing any value on Vercel, Redeploy.

# Local development: either leave it empty (Vite proxies /api to http://localhost:5000) or use the URL below
# Vercel (production): full URL of the deployed backend, ending in /api
VITE_API_URL=http://localhost:5000/api

# Badge shown in the sidebar and Settings: PRODUCTION | STAGING | LOCAL
# Optional: if empty, it is detected (localhost = LOCAL, Vercel production = PRODUCTION, Vercel preview = STAGING)
VITE_ENV_NAME=LOCAL

# Vercel only has no websocket server. Set true on Vercel so the app stops trying to connect.
VITE_SOCKET_URL=http://localhost:5000
VITE_DISABLE_SOCKET=false
