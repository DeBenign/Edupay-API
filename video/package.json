{
  "name": "edupay-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:pitch": "remotion render src/index.ts Pitch out/edupay-pitch-16x9.mp4",
    "render:teaser": "remotion render src/index.ts Teaser out/edupay-teaser-9x16.mp4",
    "render:all": "npm run render:pitch && npm run render:teaser",
    "voice": "python3 scripts/make_voice.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
